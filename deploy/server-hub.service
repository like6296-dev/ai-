# /etc/systemd/system/server-hub.service
# sudo systemctl daemon-reload && sudo systemctl enable --now server-hub
[Unit]
Description=Server Hub (서버 관리 사이트)
After=network.target

[Service]
Type=simple
# VPN(wg-quick)·QEMU·프로세스 종료 등을 쓰려면 root, 아니면 전용 사용자 권장
User=root
WorkingDirectory=/opt/server-hub
Environment=PORT=3000
Environment=DATA_DIR=/opt/server-hub/data
ExecStart=/usr/bin/node /opt/server-hub/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
