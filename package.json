{
  "name": "server-hub",
  "version": "1.0.0",
  "description": "서버 관리 사이트 — 점검 모드, 게임 연동, VPN, 가상 저장소, 가상 머신, 예약 작업, 백업, 모니터링 (의존성 없음)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node -e \"require('fs').readdirSync('lib').forEach(f=>require('./lib/'+f))\""
  },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
